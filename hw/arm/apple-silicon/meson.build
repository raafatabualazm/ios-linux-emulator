# Read-only EL0 BRK classification. Added unconditionally: it is called from
# target/arm/debug_helper.c, which is built for every arm target.
arm_common_ss.add(files('modern-el0-trap.c'))
arm_common_ss.add(when: 'CONFIG_APPLE_SOC', if_true: tasn1)
arm_common_ss.add(when: 'CONFIG_APPLE_DART', if_true: files('dart.c'),
                                             if_false: files('dart-stub.c'))
arm_common_ss.add(when: 'CONFIG_APPLE_SART', if_true: files('sart.c'))
arm_common_ss.add(when: 'CONFIG_APPLE_SOC', if_true: files(
    'a13.c',
    'a13_gxf.c',
    'a9.c',
    'boot.c',
    'dt.c',
    'dart-t8110.c',
    'mem.c',
    'modern-amcc.c',
    'modern-pmgr.c',
    'modern-pmgr-fuse.c',
    'modern-mcc-dramcfg.c',
    'modern-mcc-quota.c',
    'modern-mcc-perf.c',
    'modern-mcc-socni.c',
    'modern-mcc-socni-command.c',
    'modern-mcc-dcs-perf.c',
    'modern-pmgr-voltage.c',
    'modern-pmgr-ungate.c',
    'modern-pmp-ptd.c',
    'modern-cpu-dvfm.c',
    'modern-disp-trace.c',
    'modern-compat-groups.c',
    'modern-compat-groups-resolve.c',
    'modern-dcp-asc.c',
    'modern-pmgr-storage.c',
    'modern-mcc-dsid.c',
    'modern-mcc-slc.c',
    'modern-kc-patch.c',
    'modern-large-ramdisk.c',
    'modern-image-patch.c',
    'modern-boot-layout.c',
    'modern-boot-metadata.c',
    'modern-boot-display.c',
    'modern-disp0.c',
    'modern-boot-input.c',
    'modern-board-regions.c',
    'modern-machine.c',
    'mt-spi.c',
    'sep-sim.c',
    'sep.c',
    'patcher.c',
    'kernel_patches.c',
    'lm-backlight.c',
    's8000.c',
    't8030.c',
))
