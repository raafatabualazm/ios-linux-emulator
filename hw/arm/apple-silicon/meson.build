arm_common_ss.add(when: 'CONFIG_APPLE_SOC', if_true: tasn1)
arm_common_ss.add(when: 'CONFIG_APPLE_DART', if_true: files('dart.c'),
                                             if_false: files('dart-stub.c'))
arm_common_ss.add(when: 'CONFIG_APPLE_SART', if_true: files('sart.c'))
arm_common_ss.add(when: 'CONFIG_APPLE_SOC', if_true: files(
    'a13.c',
    'a13_gxf.c',
    'a9.c',
    'boot.c',
    'dt.c',
    'dart-t8110.c',
    'mem.c',
    'modern-amcc.c',
    'modern-pmgr.c',
    'modern-pmgr-fuse.c',
    'modern-mcc-dramcfg.c',
    'modern-mcc-quota.c',
    'modern-kc-patch.c',
    'modern-boot-layout.c',
    'modern-boot-metadata.c',
    'modern-boot-display.c',
    'modern-boot-input.c',
    'modern-board-regions.c',
    'modern-machine.c',
    'mt-spi.c',
    'sep-sim.c',
    'sep.c',
    'patcher.c',
    'kernel_patches.c',
    'lm-backlight.c',
    's8000.c',
    't8030.c',
))
